#!/bin/bash
# Portfolio Preview launcher (macOS). Double-click "Portfolio Preview.app" to use it.
# It builds your site, opens it in your browser with a status bar, and updates it
# whenever you save a content file. It stops by itself when you close the browser tab.

PORT="${PREVIEW_PORT:-4323}"
LOG="$HOME/Library/Logs/PortfolioPreview.log"

alert() {
  /usr/bin/osascript -e "display dialog \"$1\" with title \"Portfolio Preview\" buttons {\"OK\"} default button \"OK\" with icon caution" >/dev/null 2>&1
}

# The app sits next to package.json, so the project is the folder holding it.
APP_DIR="$(cd -P "$(dirname "$0")/../.." && pwd)"
ROOT="$(dirname "$APP_DIR")"

# Apps started from Finder get a bare PATH, so look for Node in the usual places.
find_node() {
  for candidate in /opt/homebrew/bin/node /usr/local/bin/node; do
    if [ -x "$candidate" ]; then echo "$candidate"; return; fi
  done
  # Version managers (nvm, fnm, ...) only set up Node in the login shell.
  /bin/zsh -lic 'command -v node' 2>/dev/null | tail -n 1
}

NODE_BIN="$(find_node)"
if [ ! -x "$NODE_BIN" ]; then
  alert "Portfolio Preview needs Node.js, which is not installed on this Mac. Install it from nodejs.org, then open Portfolio Preview again."
  exit 1
fi
export PATH="$(dirname "$NODE_BIN"):$PATH"
cd "$ROOT" || exit 1

# First run on a new computer: download the project's tools once.
if [ ! -d node_modules ]; then
  /usr/bin/osascript -e 'display notification "Setting up for the first time. This takes about a minute." with title "Portfolio Preview"' >/dev/null 2>&1
  if ! npm install --no-audit --no-fund >>"$LOG" 2>&1; then
    alert "First-time setup failed. Check your internet connection and try again. Details: $LOG"
    exit 1
  fi
fi

nohup "$NODE_BIN" tools/portfolio-preview/main.mjs >>"$LOG" 2>&1 &

# Wait until the preview answers (the server itself opens the browser).
for _ in $(seq 1 60); do
  if /usr/bin/curl -fs --max-time 1 "http://127.0.0.1:${PORT}/__preview/api/state" >/dev/null 2>&1; then exit 0; fi
  sleep 0.25
done
alert "Portfolio Preview could not start. Details are in: $LOG"
exit 1
