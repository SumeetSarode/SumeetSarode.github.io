---
/**
 * A top-to-bottom flow diagram built from plain HTML, so screen readers get a
 * real ordered list, both themes work for free, and no JavaScript is needed.
 */
interface Props {
  caption: string;
  layers: readonly { name: string; items: readonly string[] }[];
}

const { caption, layers } = Astro.props;
---

<figure class="diagram">
  <figcaption>{caption}</figcaption>
  <ol class="layers">
    {layers.map((layer) => (
      <li class="layer">
        <p class="layer-name">{layer.name}</p>
        <ul class="items">
          {layer.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</figure>

<style>
  .diagram {
    margin: var(--space-6) 0;
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  figcaption {
    margin-bottom: var(--space-5);
    color: var(--text-muted);
    font-size: var(--step-small);
  }
  .layers {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .layer {
    position: relative;
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
    background: var(--bg);
  }
  /* A small downward arrow between layers; purely decorative, so it is a shape, not text. */
  .layer:not(:last-child)::after {
    content: '';
    position: absolute;
    left: var(--space-5);
    bottom: calc(-1 * var(--space-4) - 2px);
    border-inline: 0.5rem solid transparent;
    border-top: 0.625rem solid var(--accent);
  }
  .layer-name {
    margin: 0 0 var(--space-2);
    font-weight: 600;
    font-size: var(--step-small);
  }
  .items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .items li {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    font-size: var(--step-small);
    line-height: 1.5;
  }
</style>
