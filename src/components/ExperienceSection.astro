---
import { earlierRoles, employers } from '../data/experience';
import { skillGroups } from '../data/skills';
import RoleItem from './RoleItem.astro';
import Section from './Section.astro';
import Tag from './Tag.astro';
---

<Section id="experience" title="Experience">
  <p class="muted lead">
    Over five years, from hands-on modeling to leading enterprise ML workstreams. Today that means
    production multi-agent systems.
  </p>

  {employers.map((employer) => (
    <div class="employer">
      <h3>{employer.name}</h3>
      {employer.roles.map((role) => (
        <RoleItem title={role.title} dates={role.dates} bullets={role.bullets} />
      ))}
    </div>
  ))}

  <h3 class="sub">Earlier roles</h3>
  {earlierRoles.map((role) => (
    <RoleItem
      title={role.title}
      organization={role.organization}
      dates={role.dates}
      bullets={role.bullets}
    />
  ))}

  <h3 class="sub">Skills</h3>
  <div class="skills">
    {skillGroups.map((group) => (
      <div class="group">
        <h4>{group.name}</h4>
        <ul>
          {group.skills.map((skill) => (
            <li>
              <Tag>{skill}</Tag>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Section>

<style>
  .lead {
    max-width: var(--measure);
  }
  .employer {
    margin-top: var(--space-5);
  }
  .employer h3 {
    margin-bottom: 0;
  }
  .sub {
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }
  .skills {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 48rem) {
    .skills {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .group h4 {
    margin: 0 0 var(--space-2);
    font-family: var(--font-body);
    font-size: var(--step-small);
    font-weight: 600;
  }
  .group ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
