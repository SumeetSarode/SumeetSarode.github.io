---
import { Image } from 'astro:assets';
import profile from '../assets/profile/profile.jpg';
import frame from '../config/photo-frame.json';
import { sections as nav } from '../config/sections';
import { site } from '../config/site';
import ThemeToggle from './ThemeToggle.astro';

// The same photo as the home page, in the same frame shape, shown small and round. It is
// decoration: the name next to it is what names the link, so it has no description of its own.
const avatarWidth = 120;
const avatarHeight = Math.round((avatarWidth * frame.ratioHeight) / frame.ratioWidth);
---

<header class="ink-vars site-header">
  <div class="container bar">
    <a class="identity" href="/">
      <span class="avatar">
        <Image
          src={profile}
          alt=""
          width={avatarWidth}
          height={avatarHeight}
          loading="eager"
          format="webp"
        />
      </span>
      <span class="name">{site.name}</span>
      <span class="visually-hidden">, home</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={Astro.url.pathname.startsWith(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(6 9 20 / 88%);
    backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid rgb(255 255 255 / 8%);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.25rem;
    padding-block: 0.6rem;
  }
  .identity {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    margin-right: auto;
    color: var(--text);
    text-decoration: none;
  }
  .avatar {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    overflow: hidden;
    border-radius: 50%;
    box-shadow: 0 0 0 2px rgb(255 255 255 / 22%);
  }
  .avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Zoomed in on the face, which sits in the upper part of a portrait photo. */
    object-position: 50% 0;
    transform: scale(1.4);
    transform-origin: 50% 33%;
  }
  .name {
    font-size: 0.95rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }
  nav {
    order: 3;
    width: 100%;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0;
    border-radius: var(--radius-pill);
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      color 0.2s,
      background-color 0.2s;
  }
  nav a:hover {
    color: var(--text);
  }
  nav a[aria-current='page'] {
    color: var(--text);
    background: rgb(255 255 255 / 9%);
  }
  /*
   * Phones: all five links share one row. The text grows in small steps with the screen, sized
   * from measured label widths. Wrapping stays on as a safety net, so nothing is ever cut off.
   */
  @media (min-width: 22.5rem) {
    nav a {
      padding-inline: 0.15rem;
      font-size: 0.78125rem;
    }
  }
  @media (min-width: 24rem) {
    nav a {
      padding-inline: 0.25rem;
      font-size: 0.8125rem;
    }
  }
  @media (min-width: 30rem) {
    nav a {
      padding-inline: 0.5rem;
      font-size: 0.875rem;
    }
  }
  @media (min-width: 52rem) {
    nav {
      order: 0;
      width: auto;
    }
    ul {
      gap: 0.35rem;
    }
    nav a {
      padding-inline: 1rem;
    }
  }
</style>
