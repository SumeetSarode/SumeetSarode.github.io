---
import { Picture } from 'astro:assets';
import profile from '../assets/profile/profile.jpg';
import photo from '../config/profile-photo.json';
import frame from '../config/photo-frame.json';
import { site } from '../config/site';
import { sections } from '../config/sections';
import Button from './Button.astro';
import Rich from './Rich.astro';

const { hero } = site;
// Keep the last two words together, so a lonely word never wraps onto its own line.
const rest = hero?.rest.replace(/ (\S+)$/, '\u00a0$1');
// Without a headline in profile.yaml, the line above the name shows the title instead.
const role = hero?.role ?? site.title;
// The main button leads to the first section there is (Contact has its own band below).
const start = sections.find((section) => section.key !== 'contact');

// The page decides the photo's shape; Photo Studio follows this same setting.
const frameAspect = frame.ratioHeight / frame.ratioWidth;
const frameHeight = Math.round(frame.outputWidth * frameAspect);
const frameVars = `--frame-ratio: ${frame.ratioWidth} / ${frame.ratioHeight}; --frame-aspect: ${frameAspect}`;
---

<section class="ink hero" aria-labelledby="hero-title">
  <div class="container layout">
    <div class="portrait rise" style={frameVars}>
      <div class="frame">
        <Picture
          src={profile}
          alt={photo.alt}
          widths={[480, 960]}
          sizes="(min-width: 56rem) 40vw, 64vw"
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          width={frame.outputWidth}
          height={frameHeight}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>

    <div class="copy">
      {role && (
        <p class="role rise">
          <span class="dot" aria-hidden="true" />
          {role}
        </p>
      )}
      <h1 id="hero-title" class:list={['rise rise-2', { 'name-only': !hero }]}>
        <span class="name">{site.name}</span>
        {hero && <span class="setup">{hero.setup}</span>}
        {hero && (
          <span class="punch">
            <span class="gradient-text">{hero.highlight}</span> {rest}
          </span>
        )}
      </h1>
      {hero && (
        <p class="how rise rise-3">
          <Rich text={hero.intro} />
        </p>
      )}
      {(start || site.resume) && (
        <ul class="actions rise rise-4">
          {start && (
            <li>
              <Button href={start.href}>
                {/* The space lives in the text: Astro drops a bare one after a value here. */}
                {`Explore my ${start.label.toLowerCase()} `}
                <span aria-hidden="true">→</span>
              </Button>
            </li>
          )}
          {site.resume && (
            <li>
              <Button href={site.resume.href} variant="secondary" download={site.resume.fileName}>
                Download résumé <span aria-hidden="true">↓</span>
              </Button>
            </li>
          )}
        </ul>
      )}
    </div>
  </div>
</section>

<style>
  /* Fills the screen under the header, whatever the screen. */
  .hero {
    display: grid;
    align-items: center;
    min-height: calc(100svh - 4rem);
    padding-block: clamp(1.5rem, 4vw, 3.5rem);
    border-bottom: 1px solid rgb(255 255 255 / 8%);
  }
  .layout {
    display: grid;
    gap: clamp(1.5rem, 4vw, 5rem);
    align-items: center;
  }

  /* The photo: on top on a phone, on the left from tablet width up. */
  .portrait {
    justify-self: center;
    width: min(64%, 15rem);
  }
  .frame {
    position: relative;
    padding: 4px;
    border-radius: 2rem;
    background: var(--gradient-brand);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 6%),
      0 40px 90px -30px rgb(79 70 229 / 70%);
  }
  .frame::before {
    content: '';
    position: absolute;
    inset: -25%;
    z-index: -1;
    background: radial-gradient(circle, rgb(139 92 246 / 35%), transparent 62%);
  }
  .frame :global(picture),
  .frame :global(img) {
    display: block;
    width: 100%;
  }
  .frame :global(img) {
    height: auto;
    aspect-ratio: var(--frame-ratio);
    object-fit: cover;
    border-radius: calc(2rem - 4px);
  }

  .role {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 var(--space-5);
    padding: 0.4rem 0.9rem 0.4rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 5%);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 0 4px rgb(52 211 153 / 20%);
  }

  h1 {
    margin: 0;
  }
  h1 span {
    display: block;
  }
  .name {
    margin-bottom: var(--space-4);
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-muted);
  }
  /* Without a headline in profile.yaml, the name is the headline. */
  .name-only .name {
    margin-bottom: 0;
    font-size: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
    color: var(--text);
  }
  /* The set-up line is quiet, so the punch line lands. */
  .setup {
    font-size: clamp(1.5rem, 1rem + 2vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--text-muted);
  }
  .punch {
    margin-top: 0.1em;
    font-size: clamp(2.6rem, 0.8rem + 5.4vw, 7rem);
    line-height: 1;
    letter-spacing: -0.055em;
  }
  .how {
    max-width: 38rem;
    margin: var(--space-5) 0 0;
    text-wrap: balance;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.5rem);
    line-height: 1.5;
    color: var(--text-muted);
  }
  /* The bold words come from <Rich>, a separate component, so reach them globally. */
  .how :global(strong) {
    font-weight: 650;
    color: var(--text);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 56rem) {
    .layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
    /* As large as the screen allows, but never taller than the space under the header. */
    .portrait {
      width: min(100%, calc((100svh - 9rem) / var(--frame-aspect)));
      max-width: 34rem;
    }
  }
</style>
