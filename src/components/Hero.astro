---
import { Picture } from 'astro:assets';
import profile from '../assets/profile/profile.jpg';
import photo from '../config/profile-photo.json';
import { site } from '../config/site';
import Button from './Button.astro';
---

<section class="ink hero" aria-labelledby="hero-title">
  <div class="container layout">
    <div class="copy">
      <p class="status rise">
        <span class="dot" aria-hidden="true"></span>Principal Data Scientist · Walmart
      </p>
      <h1 id="hero-title" class="rise rise-2">
        <span class="name">{site.name}</span>
        <span class="headline">
          Agentic AI, engineered for <span class="gradient-text">national scale.</span>
        </span>
      </h1>
      <p class="intro rise rise-3">{site.heroIntro}</p>
      <ul class="actions rise rise-4">
        <li>
          <Button href="/experience/">
            Explore my experience <span aria-hidden="true">→</span>
          </Button>
        </li>
        <li>
          <Button href={site.resumePath} variant="secondary" download>
            Download résumé <span aria-hidden="true">↓</span>
          </Button>
        </li>
      </ul>
    </div>

    <div class="portrait-wrap rise rise-3">
      <div class="frame">
        <Picture
          src={profile}
          alt={photo.alt}
          widths={[360, 720]}
          sizes="(min-width: 64rem) 360px, (min-width: 40rem) 320px, 70vw"
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          width={360}
          height={360}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <!-- Decorative badges. Both facts are stated in the text beside the photo and further down the page. -->
      <div class="signal signal-top" aria-hidden="true">
        <span class="signal-icon">◆</span>
        <span>
          <strong>Multi-agent AI</strong>Live in every U.S. Walmart
        </span>
      </div>
      <div class="signal signal-bottom" aria-hidden="true">
        <span class="signal-icon">▲</span>
        <span>
          <strong>Guardrailed LLMs</strong>Human-in-the-loop validation
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 5.5rem) clamp(2.5rem, 6vw, 4.5rem);
    border-bottom: 1px solid rgb(255 255 255 / 8%);
  }
  .layout {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 var(--space-5);
    padding: 0.4rem 0.9rem 0.4rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 5%);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text);
  }
  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 0 4px rgb(52 211 153 / 20%);
  }
  h1 {
    margin: 0;
  }
  .name {
    display: block;
    margin-bottom: var(--space-3);
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-muted);
  }
  .headline {
    display: block;
    max-width: 14ch;
    font-size: clamp(2.6rem, 1.5rem + 4.6vw, 5.4rem);
    line-height: 1.02;
    letter-spacing: -0.05em;
  }
  .intro {
    max-width: 36rem;
    margin: var(--space-5) 0 0;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    line-height: 1.6;
    color: var(--text-muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .portrait-wrap {
    position: relative;
    justify-self: center;
    width: min(100%, 22rem);
    padding: 1.5rem 1rem;
  }
  .frame {
    position: relative;
    padding: 4px;
    border-radius: 2rem;
    background: var(--gradient-brand);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 6%),
      0 40px 80px -30px rgb(79 70 229 / 70%);
  }
  .frame::before {
    content: '';
    position: absolute;
    inset: -30%;
    z-index: -1;
    background: radial-gradient(circle, rgb(139 92 246 / 35%), transparent 60%);
  }
  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: calc(2rem - 4px);
  }
  .signal {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.65rem 0.9rem;
    border: 1px solid rgb(255 255 255 / 14%);
    border-radius: 1rem;
    background: rgb(14 20 48 / 85%);
    backdrop-filter: blur(10px);
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 70%);
    font-size: 0.75rem;
    line-height: 1.35;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .signal strong {
    display: block;
    font-size: 0.875rem;
    color: var(--text);
  }
  .signal-icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.6rem;
    background: var(--gradient-brand);
    color: var(--ink);
    font-size: 0.75rem;
  }
  .signal-top {
    top: 0;
    left: -0.5rem;
  }
  .signal-bottom {
    right: -0.5rem;
    bottom: 0;
  }

  @media (max-width: 29.99rem) {
    .signal {
      display: none;
    }
  }
  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    }
    .portrait-wrap {
      width: 100%;
      max-width: 24rem;
      padding: 2rem 0;
    }
    .signal-top {
      left: -3rem;
    }
    .signal-bottom {
      right: -2rem;
    }
  }
</style>
