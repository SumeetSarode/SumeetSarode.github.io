---
import { splitMetrics } from '../lib/metrics';

interface Props {
  text: string;
}

const { text } = Astro.props;
---

{splitMetrics(text).map((part) =>
  part.metric ? <strong class="metric">{part.text}</strong> : part.text,
)}

<style>
  .metric {
    padding: 0 0.3em;
    border-radius: 0.35em;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--text);
    font-weight: 700;
    white-space: nowrap;
  }
</style>
