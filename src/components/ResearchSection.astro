---
import { certification, education } from '../data/education';
import { publicationMeta, publications } from '../data/publications';
import Section from './Section.astro';

// Newest first. The IEEE paper is also the most recent, so it leads.
const sorted = [...publications].sort((a, b) => b.date.localeCompare(a.date));
---

<Section id="research" title="Research and education">
  <h3>Publications</h3>
  <ul class="plain">
    {sorted.map((publication) => (
      <li>
        <p class="title">
          {publication.url ? <a href={publication.url}>{publication.title}</a> : publication.title}
        </p>
        <p class="meta muted">{publicationMeta(publication)}</p>
      </li>
    ))}
  </ul>

  <h3 class="sub">Education</h3>
  <ul class="plain">
    {education.map((entry) => (
      <li>
        <p class="title">{entry.degree}</p>
        <p class="meta muted">
          {entry.school}, {entry.dates}
        </p>
      </li>
    ))}
  </ul>
  <p class="meta muted">
    Certification: {certification.name}, {certification.issuer}, {certification.date}.
  </p>
</Section>

<style>
  .plain {
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: var(--measure);
  }
  .plain li {
    margin-bottom: var(--space-4);
  }
  .title {
    margin: 0;
    font-weight: 600;
  }
  .meta {
    margin: 0;
    font-size: var(--step-small);
  }
  .sub {
    margin-top: var(--space-6);
  }
</style>
