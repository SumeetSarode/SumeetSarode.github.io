---
import { parseInline } from '../lib/inline';

interface Props {
  text: string;
}

const parts = parseInline(Astro.props.text);
---

{parts.map((part) =>
  part.kind === 'bold' ? (
    <strong>{part.text}</strong>
  ) : part.kind === 'code' ? (
    <code>{part.text}</code>
  ) : (
    part.text
  ),
)}
