---
import { getCollection } from 'astro:content';
import { moreProjects } from '../data/more-projects';
import ProjectCard from './ProjectCard.astro';
import Section from './Section.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Section id="work" title="Selected work">
  <p class="muted lead">
    Three projects from my own time. Each case study explains the problem, the decisions behind the
    design, and what the project is not.
  </p>
  <ul class="grid">
    {projects.map((project, index) => (
      <li>
        <ProjectCard
          title={project.data.title}
          tagline={project.data.tagline}
          summary={project.data.summary}
          tags={project.data.tags}
          href={`/projects/${project.id}/`}
          featured={index === 0}
        />
      </li>
    ))}
  </ul>

  <h3 class="more-title">More on GitHub</h3>
  <ul class="more">
    {moreProjects.map((project) => (
      <li>
        <a href={project.url}>{project.name}</a>
        <span class="muted">: {project.description}</span>
      </li>
    ))}
  </ul>
</Section>

<style>
  .lead {
    max-width: var(--measure);
    margin-bottom: var(--space-5);
  }
  .grid {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .more-title {
    margin-top: var(--space-6);
  }
  .more {
    max-width: var(--measure);
    margin: 0;
    padding-left: 1.25rem;
  }
  .more li {
    margin-bottom: var(--space-3);
  }
  @media (min-width: 56rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .grid li:first-child {
      grid-column: 1 / -1;
    }
  }
</style>
