---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Page not found | Sumeet Sarode" noindex closing={false}>
  <PageHero
    eyebrow="404"
    title="That page doesn't exist."
    lead="The link may be old, or the address may have a typo. The home page links to everything on this site."
  >
    <Button href="/">Back to the home page</Button>
  </PageHero>
</BaseLayout>
