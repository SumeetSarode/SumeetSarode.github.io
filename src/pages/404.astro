---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Page not found | Sumeet Sarode" noindex>
  <section class="container missing" aria-labelledby="missing-title">
    <h1 id="missing-title">That page doesn't exist</h1>
    <p>
      The link may be old, or the address may have a typo. The home page has everything on this
      site.
    </p>
    <Button href="/">Back to the home page</Button>
  </section>
</BaseLayout>

<style>
  .missing {
    padding-block: var(--space-8);
  }
  p {
    max-width: var(--measure);
  }
</style>
