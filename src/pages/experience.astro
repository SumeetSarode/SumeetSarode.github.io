---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pages, tabTitle } from '../data/pages';
import PageHero from '../components/PageHero.astro';
import ImpactStats from '../components/ImpactStats.astro';
import MetricText from '../components/MetricText.astro';
import CapabilityStack from '../components/CapabilityStack.astro';
import { earlierRoles, employers } from '../data/experience';
import { formatRange } from '../lib/months';
---

<BaseLayout title={tabTitle('Experience')} description={pages.experience.metaDescription}>
  <PageHero eyebrow="01 / Experience" title={pages.experience.title} lead={pages.experience.lead}>
    <ImpactStats label="Impact highlights" />
  </PageHero>

  <section class="section" aria-labelledby="career-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Career</p>
          <h2 id="career-title">{pages.experience.careerHeadline}</h2>
        </div>
      </div>

      {employers.map((employer) => (
        <ol class="timeline">
          {employer.roles.map((role, index) => (
            <li class:list={['stop', { current: index === 0 }]}>
              <span class="marker" aria-hidden="true" />
              <article class="panel role">
                <div class="role-head">
                  <div class="role-meta">
                    {index === 0 && <span class="badge">Current role</span>}
                    <span class="dates">{formatRange(role.start, role.end)}</span>
                    <span class="org">{employer.name}</span>
                  </div>
                  <h3>{role.title}</h3>
                  <p class="role-summary">{role.summary}</p>
                </div>
                <ul class="bullets">
                  {role.bullets.map((bullet) => (
                    <li>
                      <MetricText text={bullet} />
                    </li>
                  ))}
                </ul>
              </article>
            </li>
          ))}
        </ol>
      ))}
    </div>
  </section>

  {earlierRoles.length > 0 && (
    <section class="section earlier-section" aria-labelledby="earlier-title">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">Foundations</p>
            <h2 id="earlier-title">Research and internships</h2>
          </div>
        </div>
        <div class="earlier">
          {earlierRoles.map((role) => (
            <article class="panel early">
              <p class="dates">{formatRange(role.start, role.end)}</p>
              <h3>{role.title}</h3>
              <p class="org">{role.organization}</p>
              <ul class="bullets">
                {role.bullets.map((bullet) => (
                  <li>
                    <MetricText text={bullet} />
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="capabilities-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">The toolkit</p>
          <h2 id="capabilities-title">Capabilities</h2>
        </div>
      </div>
      <CapabilityStack />
      <a class="route-link next" href="/projects/">
        Next: Projects <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Timeline: a vertical rail with a marker beside each role. */
  .timeline {
    position: relative;
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0 0 0 2rem;
    list-style: none;
  }
  .timeline::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 0.45rem;
    width: 2px;
    background: linear-gradient(180deg, var(--accent), var(--border) 70%);
  }
  .stop {
    position: relative;
  }
  .marker {
    position: absolute;
    top: 2rem;
    left: -2rem;
    width: 1rem;
    height: 1rem;
    border: 3px solid var(--bg);
    border-radius: 50%;
    background: var(--text-muted);
    box-shadow: 0 0 0 2px var(--border);
  }
  .current .marker {
    background: var(--accent);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 22%, transparent);
  }
  .current .role {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    box-shadow: var(--shadow-lift);
  }
  .role-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    font-size: 0.8125rem;
  }
  .badge {
    padding: 0.2rem 0.7rem;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--accent-contrast);
    font-weight: 700;
  }
  .dates {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  .org {
    color: var(--text-muted);
    font-weight: 600;
  }
  .role h3 {
    margin: var(--space-4) 0 var(--space-3);
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
  }
  .role-summary {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--text-muted);
  }
  /* The achievements: a calm list, each one set off by a rule and an accent bar. */
  .bullets {
    display: grid;
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }
  .bullets li {
    position: relative;
    padding: var(--space-4) 0 var(--space-4) 1.25rem;
    border-top: 1px solid var(--border);
  }
  .bullets li::before {
    content: '';
    position: absolute;
    top: 1.35rem;
    bottom: 1.35rem;
    left: 0;
    width: 3px;
    border-radius: 3px;
    background: var(--accent);
  }

  .earlier-section {
    border-block: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 45%, var(--bg));
  }
  .earlier {
    display: grid;
    gap: var(--space-4);
  }
  .early .dates {
    margin: 0 0 var(--space-2);
  }
  .early h3 {
    margin-bottom: var(--space-1);
    font-size: 1.25rem;
  }
  .early .org {
    margin-bottom: var(--space-4);
  }
  .early .bullets {
    font-size: 0.9375rem;
  }
  .next {
    margin-top: var(--space-6);
  }

  /* Two columns: who and when on the left (it stays in view), the achievements on the right. */
  @media (min-width: 56rem) {
    .role {
      display: grid;
      grid-template-columns: minmax(15rem, 5fr) minmax(0, 8fr);
      gap: var(--space-7);
      align-items: start;
    }
    .role-head {
      position: sticky;
      top: 6rem;
    }
    .role .bullets {
      margin-top: 0;
    }
  }

  @media (min-width: 48rem) {
    .timeline {
      padding-left: 3rem;
    }
    .marker {
      left: -3rem;
    }
    .earlier {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
