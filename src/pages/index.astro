---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ChapterCard from '../components/ChapterCard.astro';
import Emblem from '../components/Emblem.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { certifications, degrees } from '../data/education';
import { employers } from '../data/experience';
import { tiles } from '../data/pages';
import { publications, shortVenue } from '../data/publications';
import { formatRange } from '../lib/months';
import { moreProjects } from '../data/more-projects';
import { skillLayers } from '../data/skills';
import { countPhrase } from '../lib/count';
import { isOn, sectionNumber, sections } from '../config/sections';

// Oldest first, so the path reads as a climb: left to right (top to bottom on a phone).
const career = [...(employers[0]?.roles ?? [])].reverse();
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// "Five chapters. Start with the career." The count follows the sections that are on.
const chaptersTitle =
  `${countPhrase(sections.length, 'chapter')}.` +
  (isOn('experience') && sections.length > 1 ? ' Start with the career.' : '');

// Experience spans the full width; the rest sit two to a row. With an odd number left over,
// the last tile spans the row too, so no tile ever sits next to an empty gap.
const pairedTiles = sections.length - (isOn('experience') ? 1 : 0);
const lastIsWide = pairedTiles % 2 === 1;
const { signature } = site;
const wide = (key: string) => lastIsWide && sections.at(-1)?.key === key;

// Search engines read this. Name, title, and public profiles only: no phone number or address.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.jobTitle,
  url: site.url,
  sameAs: [site.links.github, site.links.linkedin].filter(Boolean),
};
---

<BaseLayout title={[site.name, site.titleInWords].filter(Boolean).join(' — ')} {jsonLd}>
  <Hero />

  <section class="section" aria-labelledby="chapters-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Explore the work</p>
          <h2 id="chapters-title">{chaptersTitle}</h2>
        </div>
      </div>

      <div class="chapters">
        {isOn('experience') && (
          <div class="slot-experience">
            <ChapterCard
              number={sectionNumber('experience')}
              label="Experience"
              title="Experience"
              description={tiles.experience}
              href="/experience/"
              cta="Explore the career"
              tone="indigo"
              featured
            >
              {career.length > 0 ? (
                <span class="path" role="list" aria-label="Career path">
                  {career.map((role, index) => (
                    <span
                      class:list={['path-step', { current: index === career.length - 1 }]}
                      role="listitem"
                    >
                      <span class="path-title">
                        {role.title}
                        {index === career.length - 1 && <span class="now">Current</span>}
                      </span>
                      <span class="path-dates">{formatRange(role.start, role.end)}</span>
                      <span class="path-summary">{role.summary}</span>
                    </span>
                  ))}
                </span>
              ) : (
                <span class="preview-list" role="list" aria-label="Capabilities">
                  {skillLayers.map((layer) => (
                    <span class="preview-line" role="listitem">
                      <Icon name={layer.icon} size={18} />
                      {layer.name}
                    </span>
                  ))}
                </span>
              )}
            </ChapterCard>
          </div>
        )}

        {isOn('projects') && (
          <div class:list={['slot-projects', { wide: wide('projects') }]}>
            <ChapterCard
              number={sectionNumber('projects')}
              label="Projects"
              title="Projects"
              description={tiles.projects}
              href="/projects/"
              cta="See the case studies"
              tone="violet"
            >
              {projects.length > 0 ? (
                <span class="mini-list" role="list" aria-label="Case studies">
                  {projects.map((project) => (
                    <span class="mini" role="listitem">
                      <Emblem {...project.data.emblem} size="md" />
                      <span class="mini-text">
                        <span class="mini-title">{project.data.title}</span>
                        <span class="mini-meta">
                          {project.data.facts[0]!.value} {project.data.facts[0]!.label}
                        </span>
                      </span>
                    </span>
                  ))}
                </span>
              ) : (
                <span class="preview-list" role="list" aria-label="Projects on GitHub">
                  {moreProjects.map((project) => (
                    <span class="preview-line" role="listitem">
                      <Icon name="code" size={18} />
                      {project.name}
                    </span>
                  ))}
                </span>
              )}
            </ChapterCard>
          </div>
        )}

        {isOn('research') && (
          <div class:list={['slot-research', { wide: wide('research') }]}>
            <ChapterCard
              number={sectionNumber('research')}
              label="Research"
              title="Research"
              description={tiles.research}
              href="/research/"
              cta="Read the research"
              tone="cyan"
            >
              <span class="research-preview">
                <span class="paper-emblems" aria-hidden="true">
                  {publications.map((paper) => (
                    <Emblem {...paper.emblem} size="md" />
                  ))}
                </span>
                <span class="big-number">
                  {String(publications.length).padStart(2, '0')}
                  <span>publications</span>
                </span>
                <span class="chips" role="list" aria-label="Venues">
                  {publications.map((paper) => (
                    <span role="listitem">{shortVenue(paper)}</span>
                  ))}
                </span>
              </span>
            </ChapterCard>
          </div>
        )}

        {isOn('education') && (
          <div class:list={['slot-education', { wide: wide('education') }]}>
            <ChapterCard
              number={sectionNumber('education')}
              label="Education"
              title="Education"
              description={tiles.education}
              href="/education/"
              cta="See education"
              tone="indigo"
            >
              <span class="education-preview">
                {degrees.length > 0 && (
                  <span class="preview-list" role="list" aria-label="Degrees">
                    {degrees.map((item) => (
                      <span class="preview-line" role="listitem">
                        <Icon name="graduation-cap" size={18} />
                        {item.degree}
                      </span>
                    ))}
                  </span>
                )}
                {certifications.length > 0 && (
                  <span class="preview-list" role="list" aria-label="Recent certifications">
                    {certifications.slice(0, 2).map((cert) => (
                      <span class="preview-line" role="listitem">
                        <Icon name="award" size={18} />
                        {cert.name}
                      </span>
                    ))}
                  </span>
                )}
              </span>
            </ChapterCard>
          </div>
        )}

        <div class:list={['slot-contact', { wide: wide('contact') }]}>
          <ChapterCard
            number={sectionNumber('contact')}
            label="Contact"
            title="Let's talk"
            description={tiles.contact}
            href="/contact/"
            cta="Get in touch"
            tone="ink"
          >
            <span class="contact-preview">{site.email}</span>
          </ChapterCard>
        </div>
      </div>
    </div>
  </section>

  {signature && (
    <section class="section signature" aria-labelledby="signature-title">
      <div class="container">
        <p class="eyebrow">Signature work</p>
        <h2 id="signature-title">{signature.headline}</h2>
        <ol class="pillars">
          {signature.highlights.map((highlight, index) => (
            <li>
              <span class="pillar-number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3>{highlight.title}</h3>
              <p>{highlight.description}</p>
            </li>
          ))}
        </ol>
        {isOn('experience') && (
          <a class="route-link" href="/experience/">
            See the full career story <span aria-hidden="true">→</span>
          </a>
        )}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .chapters {
    display: grid;
    gap: var(--space-4);
  }
  .chapters > div {
    min-width: 0;
  }

  /* Experience preview: the roles as steps on a line. Vertical on a phone, horizontal from tablet up. */
  .path {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-2) 0 0 2.25rem;
  }
  .path-step {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.25rem;
  }
  .path-step:last-child {
    flex: 0 0 auto;
  }
  /* The line: one segment from each marker to the next marker. */
  .path-step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 1.5rem;
    bottom: calc(-1 * var(--space-5) - 0.35rem);
    left: calc(-2.25rem + 0.5rem);
    width: 2px;
    background: linear-gradient(180deg, var(--border), var(--accent));
  }
  .path-step::before {
    content: '';
    position: absolute;
    top: 0.35rem;
    left: -2.25rem;
    width: 1.125rem;
    height: 1.125rem;
    border: 2px solid var(--border);
    border-radius: 50%;
    background: var(--surface);
  }
  .current::before {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 20%, transparent);
  }
  .path-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .now {
    padding: 0.15rem 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--accent-contrast);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0;
  }
  .path-dates {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .path-summary {
    max-width: 34rem;
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  /* Projects preview. */
  .mini-list {
    display: grid;
    gap: var(--space-2);
  }
  .mini {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-small);
    background: color-mix(in srgb, var(--bg) 60%, transparent);
  }
  .mini-text {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }
  .mini-title {
    font-size: 0.9375rem;
    font-weight: 650;
  }
  .mini-meta {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  /* Research preview. */
  .research-preview {
    display: grid;
    gap: var(--space-4);
  }
  .education-preview {
    display: grid;
    gap: var(--space-4);
  }
  .preview-list {
    display: grid;
    gap: var(--space-2);
  }
  .preview-line {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    font-weight: 650;
    color: var(--text);
  }
  .preview-line :global(svg) {
    flex: none;
    color: var(--accent);
  }
  .paper-emblems {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding: 0 0.5rem 0.25rem 0;
  }
  .big-number {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-size: clamp(3.5rem, 3rem + 2vw, 4.5rem);
    font-weight: 750;
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .big-number span {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--text-muted);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .chips span {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .contact-preview {
    font-size: clamp(1rem, 0.9rem + 0.6vw, 1.375rem);
    font-weight: 600;
    word-break: break-all;
  }

  /* Signature work. */
  .signature {
    border-top: 1px solid var(--border);
  }
  .signature h2 {
    max-width: 24ch;
    font-size: clamp(1.9rem, 1.3rem + 2.6vw, 3.5rem);
  }
  .pillars {
    display: grid;
    gap: var(--space-4);
    margin: clamp(2rem, 5vw, 3.5rem) 0 var(--space-5);
    padding: 0;
    list-style: none;
  }
  .pillars li {
    padding: var(--space-5) 0 0;
    border-top: 2px solid var(--border);
  }
  .pillar-number {
    display: block;
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
  }
  .pillars h3 {
    font-size: 1.25rem;
  }
  .pillars p {
    margin: 0;
    color: var(--text-muted);
  }

  @media (min-width: 48rem) {
    .chapters {
      grid-template-columns: repeat(2, 1fr);
    }
    .slot-experience,
    .wide {
      grid-column: 1 / -1;
    }
    .pillars {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }
    /* The career path runs left to right, one column per role. */
    .path {
      flex-direction: row;
      gap: var(--space-6);
      padding: var(--space-3) 0 0;
    }
    .path-step,
    .path-step:last-child {
      flex: 1;
      padding-top: 2.25rem;
    }
    .path-step::before {
      top: 0;
      left: 0;
    }
    .path-step:not(:last-child)::after {
      top: 0.5rem;
      right: calc(-1 * var(--space-6));
      bottom: auto;
      left: 1.25rem;
      width: auto;
      height: 2px;
      background: linear-gradient(90deg, var(--border), var(--accent));
    }
    .path-title {
      font-size: clamp(1.25rem, 1rem + 0.8vw, 1.75rem);
      line-height: 1.2;
    }
    /* The badge sits on the marker row, so it never pushes the text below it out of line. */
    .now {
      position: absolute;
      top: 0;
      left: 2.25rem;
    }
    .path-dates {
      font-size: 0.8125rem;
    }
    .path-summary {
      font-size: 1rem;
    }
  }
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    /* Long titles wrap here, so every title gets two lines and the dates below stay aligned. */
    .path-title {
      min-height: 2.4em;
      align-items: flex-start;
    }
  }
</style>
