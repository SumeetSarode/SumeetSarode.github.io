---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import FlowDiagram from '../../components/FlowDiagram.astro';
import HighlightCards from '../../components/HighlightCards.astro';
import PageHero from '../../components/PageHero.astro';
import Emblem from '../../components/Emblem.astro';
import Rich from '../../components/Rich.astro';
import Tag from '../../components/Tag.astro';
import { site } from '../../config/site';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, index) => ({
    params: { slug: project.id },
    // The last case study links back to the first, so every page has a "next".
    props: { project, next: projects[(index + 1) % projects.length]! },
  }));
}

const { project, next } = Astro.props;
const { data } = project;
const checked = data.checkedOn.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const title = `${data.title} \u2014 Case Study | ${site.name}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.metaDescription,
  dateModified: data.checkedOn.toISOString().slice(0, 10),
  author: { '@type': 'Person', name: site.name, url: site.url },
};
---

<BaseLayout {title} description={data.metaDescription} type="article" {jsonLd}>
  <PageHero
    eyebrow={`Case study · ${String(data.order).padStart(2, '0')}`}
    title={data.title}
    lead={data.tagline}
  >
    <div slot="visual">
      <Emblem {...data.emblem} size="lg" />
    </div>
    <a slot="before" class="route-link back" href="/projects/">
      <span aria-hidden="true">←</span> All projects
    </a>
    <ul class="tags" aria-label="Technologies">
      {data.tags.map((tag) => (
        <li>
          <Tag>{tag}</Tag>
        </li>
      ))}
    </ul>
    <p class="status">{data.status}</p>
    {data.disclaimer && (
      <p class="disclaimer" role="note">
        <strong>Note:</strong> {data.disclaimer}
      </p>
    )}
    <Button href={data.repoUrl} variant="secondary">
      View the code on GitHub <span aria-hidden="true">↗</span>
    </Button>
  </PageHero>

  <article class="container case">
    <section class="block" aria-labelledby="challenge-title">
      <p class="eyebrow">The challenge</p>
      <h2 id="challenge-title" class="statement">
        <Rich text={data.challenge.statement} />
      </h2>
      <div class="measure">
        {data.challenge.paragraphs.map((paragraph) => (
          <p>
            <Rich text={paragraph} />
          </p>
        ))}
      </div>
    </section>

    <section class="block" aria-labelledby="how-title">
      <p class="eyebrow">The build</p>
      <h2 id="how-title">How it works</h2>
      <div class="measure">
        {data.how.intro.map((paragraph) => (
          <p>
            <Rich text={paragraph} />
          </p>
        ))}
      </div>
      {data.how.list && (
        <div class="list-block">
          {data.how.listTitle && <h3>{data.how.listTitle}</h3>}
          <ul class="checks">
            {data.how.list.map((entry) => (
              <li>
                {entry.label && <strong>{entry.label}</strong>} <Rich text={entry.text} />
              </li>
            ))}
          </ul>
        </div>
      )}
      <FlowDiagram caption={data.how.flow.caption} steps={data.how.flow.steps} />
    </section>

    <section class="block" aria-labelledby="highlights-title">
      <p class="eyebrow">The thinking</p>
      <h2 id="highlights-title">What makes it tick</h2>
      <HighlightCards highlights={data.highlights} />
    </section>

    <section class="block limits" aria-labelledby="limits-title">
      <h2 id="limits-title">What it is not</h2>
      <div class="measure">
        {data.limits.map((paragraph) => (
          <p>
            <Rich text={paragraph} />
          </p>
        ))}
      </div>
    </section>

    {data.attribution && (
      <aside class="attribution" aria-labelledby="credit-title">
        <h2 id="credit-title">Credit</h2>
        <p>{data.attribution}</p>
      </aside>
    )}

    <p class="checked muted">
      Facts checked against the project's repository on{' '}
      <time datetime={data.checkedOn.toISOString().slice(0, 10)}>{checked}</time>.
    </p>

    <nav class="next" aria-label="More case studies">
      <a href={`/projects/${next.id}/`}>
        <Emblem {...next.data.emblem} />
        <span class="next-text">
          <span class="next-kicker">Next case study</span>
          <span class="next-title">{next.data.title}</span>
          <span class="next-summary">{next.data.summary}</span>
        </span>
        <span class="next-arrow" aria-hidden="true">
          →
        </span>
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  .case {
    padding-block: var(--space-6) var(--space-7);
  }
  .back {
    margin-bottom: var(--space-4);
    color: var(--text-muted);
    text-decoration: none;
    font-size: var(--step-small);
  }
  .back:hover {
    color: var(--text);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }
  .status {
    color: var(--text-muted);
    font-size: var(--step-small);
  }
  .disclaimer {
    max-width: var(--measure);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius-small);
    background: var(--surface);
    font-size: var(--step-small);
  }
  /* Each part of the story is its own block with room around it. */
  .block {
    margin-top: clamp(3rem, 7vw, 5.5rem);
  }
  .block h2 {
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
  }
  /* The challenge, as one big sentence. */
  .statement {
    max-width: 26ch;
    font-size: clamp(1.9rem, 1.2rem + 2.8vw, 3.5rem) !important;
    line-height: 1.1;
  }
  .measure {
    max-width: 46rem;
  }
  .measure :global(code),
  .checks :global(code) {
    padding: 0.1em 0.35em;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    background: var(--surface);
    font-size: 0.9em;
  }
  .list-block {
    margin-top: var(--space-5);
  }
  .list-block h3 {
    margin-bottom: var(--space-3);
    font-size: 1.25rem;
  }
  .checks {
    display: grid;
    gap: var(--space-2) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .checks li {
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--accent);
    background: var(--surface);
    border-radius: 0 var(--radius-small) var(--radius-small) 0;
  }
  .limits .measure {
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border);
    border-left: 4px solid var(--text-muted);
    border-radius: var(--radius-small);
    background: var(--surface);
  }
  .limits .measure :global(p:last-child) {
    margin-bottom: 0;
  }
  .attribution {
    max-width: var(--measure);
    margin-top: var(--space-6);
    padding: var(--space-4) var(--space-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .attribution h2 {
    font-size: var(--step-1);
  }
  .attribution p {
    margin: 0;
  }
  .checked {
    margin-top: var(--space-6);
    font-size: var(--step-small);
  }

  /* The next case study is a whole card, with its emblem. */
  .next {
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }
  .next a {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    color: inherit;
    text-decoration: none;
  }
  .next a:hover .next-title {
    text-decoration: underline;
  }
  .next-text {
    display: grid;
    flex: 1;
    gap: 0.2rem;
    min-width: 0;
  }
  .next-kicker {
    font-size: var(--step-small);
    color: var(--text-muted);
  }
  .next-title {
    font-family: var(--font-heading);
    font-size: var(--step-1);
    font-weight: 650;
  }
  .next-summary {
    max-width: 52rem;
    font-size: var(--step-small);
    color: var(--text-muted);
  }
  .next-arrow {
    font-size: 1.5rem;
    color: var(--accent);
  }

  @media (max-width: 39.99rem) {
    /* On a phone the emblem sits above the text, so the title gets the full width. */
    .next a {
      flex-direction: column;
      align-items: flex-start;
    }
    .next-arrow {
      display: none;
    }
  }
  @media (min-width: 48rem) {
    .checks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
