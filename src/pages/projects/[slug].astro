---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchitectureDiagram from '../../components/ArchitectureDiagram.astro';
import Button from '../../components/Button.astro';
import PageHero from '../../components/PageHero.astro';
import Tag from '../../components/Tag.astro';
import { site } from '../../config/site';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, index) => ({
    params: { slug: project.id },
    // The last case study links back to the first, so every page has a "next".
    props: { project, next: projects[(index + 1) % projects.length]! },
  }));
}

const { project, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const checked = data.checkedOn.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const title = `${data.title} \u2014 Case Study | ${site.name}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.metaDescription,
  dateModified: data.checkedOn.toISOString().slice(0, 10),
  author: { '@type': 'Person', name: site.name, url: site.url },
};
---

<BaseLayout {title} description={data.metaDescription} type="article" {jsonLd}>
  <PageHero
    eyebrow={`Case study · ${String(data.order).padStart(2, '0')}`}
    title={data.title}
    lead={data.tagline}
  >
    <a slot="before" class="route-link back" href="/projects/">
      <span aria-hidden="true">←</span> All projects
    </a>
    <ul class="tags" aria-label="Technologies">
      {data.tags.map((tag) => (
        <li>
          <Tag>{tag}</Tag>
        </li>
      ))}
    </ul>
    <p class="status">{data.status}</p>
    {data.disclaimer && (
      <p class="disclaimer" role="note">
        <strong>Note:</strong> {data.disclaimer}
      </p>
    )}
    <Button href={data.repoUrl} variant="secondary">
      View the code on GitHub <span aria-hidden="true">↗</span>
    </Button>
  </PageHero>

  <article class="container case">
    <ul class="facts" aria-label="Key facts">
      {data.facts.map((fact) => (
        <li>
          <strong>{fact.value}</strong>
          <span>{fact.label}</span>
        </li>
      ))}
    </ul>

    <ArchitectureDiagram caption={data.diagram.caption} layers={data.diagram.layers} />

    <div class="prose body">
      <Content />
    </div>

    {data.attribution && (
      <aside class="attribution" aria-labelledby="credit-title">
        <h2 id="credit-title">Credit</h2>
        <p>{data.attribution}</p>
      </aside>
    )}

    <p class="checked muted">
      Facts checked against the project's repository on{' '}
      <time datetime={data.checkedOn.toISOString().slice(0, 10)}>{checked}</time>.
    </p>

    <nav class="next" aria-label="More case studies">
      <p class="muted">Next case study</p>
      <a href={`/projects/${next.id}/`}>{next.data.title} &rarr;</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .case {
    padding-block: var(--space-6) var(--space-7);
  }
  .back {
    margin-bottom: var(--space-4);
    color: var(--text-muted);
    text-decoration: none;
    font-size: var(--step-small);
  }
  .back:hover {
    color: var(--text);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }
  .status {
    color: var(--text-muted);
    font-size: var(--step-small);
  }
  .disclaimer {
    max-width: var(--measure);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius-small);
    background: var(--surface);
    font-size: var(--step-small);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-4);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }
  .facts li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
  }
  .facts strong {
    font-size: clamp(2.25rem, 1.8rem + 1.6vw, 3.25rem);
    font-weight: 750;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--accent);
  }
  .facts span {
    color: var(--text-muted);
    font-size: var(--step-small);
  }
  .body {
    margin-top: var(--space-6);
  }
  .body :global(h2) {
    margin-top: var(--space-6);
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem);
  }
  .body :global(h2:first-child) {
    margin-top: 0;
  }
  .body :global(li) {
    margin-bottom: var(--space-2);
  }
  .body :global(code) {
    padding: 0.1em 0.35em;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.25rem;
  }
  .attribution {
    max-width: var(--measure);
    margin-top: var(--space-6);
    padding: var(--space-4) var(--space-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .attribution h2 {
    font-size: var(--step-1);
  }
  .attribution p {
    margin: 0;
  }
  .checked {
    margin-top: var(--space-6);
    font-size: var(--step-small);
  }
  .next {
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }
  .next p {
    margin: 0 0 var(--space-1);
    font-size: var(--step-small);
  }
  .next a {
    font-family: var(--font-heading);
    font-size: var(--step-1);
    font-weight: 600;
  }
</style>
